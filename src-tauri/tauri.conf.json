{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "Vidya Prabandh Demo",
    "version":  "1.0.0",
    "identifier":  "com.vidyaprabandh.demo",
    "build":  {
                  "beforeBuildCommand":  "npm run build",
                  "frontendDist":  "../dist"
              },
    "app":  {
                "windows":  [
                                {
                                    "title":  "Vidya Prabandh - School ERP Demo",
                                    "width":  1440,
                                    "height":  920,
                                    "minWidth":  1024,
                                    "minHeight":  700,
                                    "resizable":  true
                                }
                            ],
                "security":  {
                                 "csp":  null
                             }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  [
                                   "nsis"
                               ],
                   "icon":  [
                                "icons/icon.ico"
                            ],
                   "externalBin":  [
                                       "binaries/backend-erp",
                                       "binaries/backend-id"
                                   ],
                   "windows":  {
                                   "nsis":  {
                                                "installMode":  "currentUser",
                                                "displayLanguageSelector":  false,
                                                "compression":  "none"
                                            }
                               }
               }
}
