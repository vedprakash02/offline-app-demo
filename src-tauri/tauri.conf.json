{
  "productName": "Vidya Prabandh Demo",
  "version": "1.1.0",
  "identifier": "com.vidyaprabandh.demo",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Vidya Prabandh - School ERP ",
        "width": 1440,
        "height": 920,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEzMjVCMkJFQUQ0MTBDOQpSV1RKRU5UcUsxc3lDc2tycHlZdnhqZzRLZnVLN1Vzb1VLcHY0bWJBNTg3WEFTdU5pL1lTUkJDVQo=",
      "endpoints": [
        "https://github.com/vedprakash02/offline-app-demo/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "basicUi"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/backend-erp",
      "binaries/backend-id"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "compression": "none"
      }
    }
  }
}